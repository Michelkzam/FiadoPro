# =============================================
# FiadoPro - Variaveis de Ambiente
# Copie este arquivo para .env e preencha
# =============================================

# =============================================
# SUPABASE (OBRIGATORIO)
# =============================================
# URL do projeto Supabase (Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Chave anonima do Supabase (Dashboard > Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=

# Chave de servico do Supabase (Dashboard > Settings > API > service_role)
# ATENCAO: Nunca exponha esta chave no frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# =============================================
# VAPID KEYS (WEB PUSH)
# =============================================
# Gerar chaves: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:seu@email.com

# =============================================
# WEBHOOK SECURITY (OBRIGATORIO PARA PRODUCAO)
# =============================================
# Gerar secret: openssl rand -hex 32
# Configure este mesmo valor na Evolution API
WEBHOOK_SECRET=

# =============================================
# CORS (PRODUCAO)
# =============================================
# URL do frontend em producao (ex: https://fiadopro.vercel.app)
ALLOWED_ORIGIN=https://fiadopro.vercel.app

# =============================================
# WHATSAPP - Z-API (OPCIONAL)
# =============================================
# Configuravel via UI do FiadoPro
VITE_ZAPI_INSTANCE_ID=
VITE_ZAPI_TOKEN=

# =============================================
# WHATSAPP - EVOLUTION API (OPCIONAL)
# =============================================
# URL e chave da Evolution API (configuravel via UI)
VITE_EVOLUTION_API_URL=
VITE_EVOLUTION_API_KEY=

# =============================================
# WHATSAPP - BAILEYS (GRATUITO)
# =============================================
# Servidor roda na porta 3001 (iniciar com: npm run wa:server)
# Nao requer configuracao de API

# =============================================
# META WHATSAPP BUSINESS API (OPCIONAL)
# =============================================
# Para envio de campanhas via Meta
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
